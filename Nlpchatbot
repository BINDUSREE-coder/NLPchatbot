# ============================================================
# PROCESS FUNCTION
# ============================================================

def analyze_paragraph(button):

    paragraph = paragraph_input.value.strip()

    if not paragraph:

        token_output.value = """
        <p style="color:red;">
        Please enter a paragraph.
        </p>
        """

        return


    # ========================================================
    # TOKENIZATION
    # ========================================================

    tokens = word_tokenize(paragraph)


    # ========================================================
    # STEMMING
    # ========================================================

    stems = []

    for word in tokens:

        if word.isalpha():

            stems.append(
                stemmer.stem(word)
            )

        else:

            stems.append(word)


    # ========================================================
    # LEMMATIZATION
    # ========================================================

    lemmas = []

    for word in tokens:

        if word.isalpha():

            lemmas.append(
                lemmatizer.lemmatize(word)
            )

        else:

            lemmas.append(word)


    # ========================================================
    # TOKENIZATION HTML
    # ========================================================

    token_html = """
    <div style="
        background:white;
        padding:15px;
        border-radius:10px;
        height:250px;
        overflow:auto;
        color:black;
        font-size:15px;
        line-height:1.8;">
    """

    for i, word in enumerate(tokens, 1):

        token_html += f"""
        <span style="
            background:#ebf5fb;
            color:black;
            padding:5px 8px;
            margin:3px;
            border-radius:5px;
            display:inline-block;">

            {i}. {word}

        </span>
        """

    token_html += "</div>"

    token_output.value = token_html


    # ========================================================
    # STEMMING HTML
    # ========================================================

    stem_html = """
    <div style="
        background:white;
        padding:15px;
        border-radius:10px;
        height:250px;
        overflow:auto;
        color:black;
        font-size:15px;
        line-height:1.8;">
    """

    for i, word in enumerate(stems, 1):

        stem_html += f"""
        <span style="
            background:#e8f8f5;
            color:black;
            padding:5px 8px;
            margin:3px;
            border-radius:5px;
            display:inline-block;">

            {i}. {word}

        </span>
        """

    stem_html += "</div>"

    stem_output.value = stem_html


    # ========================================================
    # LEMMATIZATION HTML
    # ========================================================

    lemma_html = """
    <div style="
        background:white;
        padding:15px;
        border-radius:10px;
        height:250px;
        overflow:auto;
        color:black;
        font-size:15px;
        line-height:1.8;">
    """

    for i, word in enumerate(lemmas, 1):

        lemma_html += f"""
        <span style="
            background:#fef9e7;
            color:black;
            padding:5px 8px;
            margin:3px;
            border-radius:5px;
            display:inline-block;">

            {i}. {word}

        </span>
        """

    lemma_html += "</div>"

    lemma_output.value = lemma_html


    # ========================================================
    # SENTIMENT ANALYSIS
    # ========================================================

    sentiment_scores = sentiment_analyzer.polarity_scores(
        paragraph
    )

    compound = sentiment_scores["compound"]

    if compound >= 0.05:

        sentiment = "Positive 😊"
        sentiment_color = "#27ae60"

    elif compound <= -0.05:

        sentiment = "Negative 😞"
        sentiment_color = "#e74c3c"

    else:

        sentiment = "Neutral 😐"
        sentiment_color = "#7f8c8d"


    sentiment_output.value = f"""
    <div style="
        background:white;
        padding:20px;
        border-radius:10px;
        color:black;
        height:250px;
        box-sizing:border-box;">

        <h2 style="
            color:{sentiment_color};
            text-align:center;">
            {sentiment}
        </h2>

        <hr>

        <p style="color:black;">
            <b>Compound Score:</b>
            {compound:.3f}
        </p>

        <p style="color:black;">
            <b>Positive Score:</b>
            {sentiment_scores["pos"]:.3f}
        </p>

        <p style="color:black;">
            <b>Negative Score:</b>
            {sentiment_scores["neg"]:.3f}
        </p>

        <p style="color:black;">
            <b>Neutral Score:</b>
            {sentiment_scores["neu"]:.3f}
        </p>

    </div>
    """


    # ========================================================
    # NAMED ENTITY RECOGNITION
    # ========================================================

    tagged_words = pos_tag(tokens)

    named_entities = ne_chunk(
        tagged_words
    )


    entities = []

    for chunk in named_entities:

        if isinstance(chunk, Tree):

            entity_name = " ".join(
                word for word, tag in chunk.leaves()
            )

            entity_type = chunk.label()

            entities.append(
                (entity_name, entity_type)
            )


    # ========================================================
    # ENTITY RESULT
    # ========================================================

    if entities:

        entity_html = """
        <div style="
            background:white;
            padding:15px;
            border-radius:10px;
            height:250px;
            overflow:auto;
            color:black;">
        """

        for name, entity_type in entities:

            entity_html += f"""

            <div style="
                background:#fdf2e9;
                border-left:5px solid #e67e22;
                padding:10px;
                margin:8px 0;
                border-radius:5px;
                color:black;">

                <b style="color:black;">
                    {name}
                </b>

                <span style="
                    color:#e67e22;
                    margin-left:10px;">

                    [{entity_type}]

                </span>

            </div>

            """

        entity_html += "</div>"

    else:

        entity_html = """
        <div style="
            background:white;
            padding:20px;
            border-radius:10px;
            height:250px;
            color:black;">

            <p style="color:black;">
                No named entities detected.
            </p>

        </div>
        """


    entity_output.value = entity_html


# ============================================================
# CONNECT BUTTON
# ============================================================

process_button.on_click(
    analyze_paragraph
)
